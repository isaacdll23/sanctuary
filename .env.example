# Sanctuary environment configuration.
# Copy to `.env` for local development and fill in real values. Never commit
# secrets. See docs/plan-openrouter-day-routine.md for the AI configuration plan.

# --- Core ---
DATABASE_URL=
# Session signing secret. SESSION_SECRETS (comma-separated rotation list) takes
# precedence when set.
SESSION_SECRET=
# SESSION_SECRETS=
# Encrypts notes and stored OAuth tokens; must stay stable across restarts.
TOKEN_ENCRYPTION_KEY=
# Public base URL used in invite and profile links.
BASE_URL=http://localhost:5173

# --- AI (app/modules/ai.server.ts, via the Vercel AI SDK) ---
# Only OPENAI_API_KEY is required; when set, isAiConfigured() enables AI
# features. Leave OPENAI_BASE_URL commented out for the OpenAI platform, or
# uncomment it and point it at an OpenAI-compatible gateway (e.g.
# https://openrouter.ai/api/v1). It must be omitted entirely, not left blank:
# a blank value crashes the server at boot.
OPENAI_API_KEY=
# OPENAI_BASE_URL=
# Model resolution order: OPENAI_MODEL_<FEATURE> -> OPENAI_MODEL -> gpt-6-luna.
OPENAI_MODEL=gpt-6-luna
OPENAI_MODEL_NOTE_TITLE=
OPENAI_MODEL_ASSISTANT=
OPENAI_MODEL_CONVERSATION_TITLE=

# --- Email notifications (Resend) ---
RESEND_API_KEY=

# --- Web Push notifications (VAPID, app/modules/services/PushNotificationService.ts) ---
# Generate a key pair once with `npx web-push generate-vapid-keys` and set both
# values. The public key is also sent to the browser; the private key is a
# secret and must never be committed or exposed to the client. While either key
# is missing, isPushConfigured() returns false and push stays disabled (the
# Settings tab reports it as unconfigured), exactly like RESEND_API_KEY.
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
# Contact for the push service: a mailto: or https: URL.
VAPID_SUBJECT=mailto:notifications@sanctuary.isaacdelalama.dev

# --- Task reminder dispatcher (docs/task-reminders.md) ---
# In-process interval that claims due task reminders and pushes them once.
# Default 60000 (1 minute); 0 disables it. Reminders only run when VAPID keys
# are set. TASK_REMINDER_BATCH_SIZE bounds one run (default 50, max 200).
# TASK_REMINDER_INTERVAL_MS=60000
# TASK_REMINDER_BATCH_SIZE=50

# --- Google Calendar OAuth (currently dormant) ---
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=

# --- Budget invites ---
BUDGET_INVITE_SECRET=

# --- Runtime (react-router-serve / remote MCP server) ---
# HOST=127.0.0.1
# PORT=3000
