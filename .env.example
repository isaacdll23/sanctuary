# Sanctuary environment configuration.
# Copy to `.env` for local development and fill in real values. Never commit
# secrets. See docs/plan-openrouter-day-routine.md for the AI configuration plan.

# --- Core ---
DATABASE_URL=
# Session signing secret. SESSION_SECRETS (comma-separated rotation list) takes
# precedence when set.
SESSION_SECRET=
# SESSION_SECRETS=
# Encrypts notes and stored OAuth tokens; must stay stable across restarts.
TOKEN_ENCRYPTION_KEY=
# Public base URL used in invite and profile links.
BASE_URL=http://localhost:5173

# --- AI (app/modules/ai.server.ts, via the Vercel AI SDK) ---
# Only OPENAI_API_KEY is required; when set, isAiConfigured() enables AI
# features. Leave OPENAI_BASE_URL commented out for the OpenAI platform, or
# uncomment it and point it at an OpenAI-compatible gateway (e.g.
# https://openrouter.ai/api/v1). It must be omitted entirely, not left blank:
# a blank value crashes the server at boot.
OPENAI_API_KEY=
# OPENAI_BASE_URL=
# Model resolution order: OPENAI_MODEL_<FEATURE> -> OPENAI_MODEL -> gpt-6-luna.
OPENAI_MODEL=gpt-6-luna
OPENAI_MODEL_NOTE_TITLE=
OPENAI_MODEL_ASSISTANT=
OPENAI_MODEL_CONVERSATION_TITLE=

# --- Email notifications (Resend) ---
RESEND_API_KEY=

# --- Google Calendar OAuth (currently dormant) ---
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=

# --- Budget invites ---
BUDGET_INVITE_SECRET=

# --- Runtime (react-router-serve / remote MCP server) ---
# HOST=127.0.0.1
# PORT=3000
