{
  "name": "sanctuary",
  "private": true,
  "type": "module",
  "scripts": {
    "build": "react-router build",
    "dev": "react-router dev",
    "start": "react-router-serve ./build/server/index.js",
    "build:mcp": "esbuild scripts/remote-mcp-phase-0-server.ts --bundle --packages=external --platform=node --format=esm --outfile=build/mcp/server.js",
    "start:mcp": "npm run build:mcp && node build/mcp/server.js",
    "start:remote-mcp-phase-0": "npm run start:mcp",
    "typecheck": "react-router typegen && tsc",
    "test": "node --import tsx --test \"app/**/*.test.ts\"",
    "test:watch": "node --import tsx --test --watch \"app/**/*.test.ts\""
  },
