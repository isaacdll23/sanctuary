    "@modelcontextprotocol/server": "^2.3.1",
    "@react-router/express": "^8.3.0",
    "@react-router/node": "^8.3.0",
    "@react-router/serve": "^8.3.0",
    "argon2": "^0.45.1",
    "date-fns": "^4.1.0",
    "dotenv": "^18.0.7",
    "drizzle-orm": "^0.45.2",
    "express": "^5.3.0",
    "isbot": "^5.1.28",
    "jsonwebtoken": "^9.0.2",
    "openai": "^7.32.0",
    "pg": "^8.16.0",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
